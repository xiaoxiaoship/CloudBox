{
  "name": "cloudbox",
  "version": "1.0.0",
  "private": true,
  "description": "CloudBox - local multi-user network drive (Electron + Express + SQLite)",
  "author": "CloudBox",
  "type": "module",
  "main": "dist/main/main.cjs",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev:server": "node --watch --env-file-if-exists=.env src/server/index.ts",
    "start:server": "node --env-file-if-exists=.env src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "seed:admin": "node scripts/seed-admin.ts",
    "seed:admin:reset": "node scripts/seed-admin.ts --reset",
    "dev:web": "vite",
    "build:web": "tsc -p web/tsconfig.json && vite build",
    "preview:web": "vite preview",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "e2e:web": "node scripts/e2e-web.ts",
    "e2e:web:features": "node scripts/e2e-web-features.ts",
    "e2e:web:register": "node scripts/e2e-web-register.ts",
    "e2e:web:security": "node scripts/e2e-web-security.ts",
    "e2e:web:ai": "node scripts/e2e-web-ai.ts",
    "e2e:web:hosting": "node scripts/e2e-web-hosting.ts",
    "e2e:web:audio": "node scripts/e2e-web-audio.ts",
    "e2e:web:i18n": "node scripts/e2e-web-i18n.ts",
    "build:admin": "tsc -p admin/tsconfig.json && vite build --config vite.admin.config.ts",
    "build:main": "node scripts/build-electron.mjs",
    "build:desktop": "npm run build:admin && npm run build:main",
    "electron:start": "node scripts/start-electron.mjs",
    "electron:dev": "npm run build:desktop && node scripts/start-electron.mjs",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "e2e:electron": "node scripts/e2e-electron.ts",
    "e2e:electron:network": "node scripts/e2e-electron-network.ts",
    "e2e:electron:directories": "node scripts/e2e-electron-directories.ts",
    "e2e:electron:plugins": "node scripts/e2e-electron-plugins.ts",
    "dist:win": "npm run build:web && npm run build:desktop && electron-builder --win"
  },
  "dependencies": {
    "@mkcert/node": "^0.1.3",
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "busboy": "^1.6.0",
    "chardet": "^2.2.0",
    "clamscan": "^2.4.0",
    "docx-preview": "^0.4.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "i18next": "^26.7.2",
    "iconv-lite": "^0.7.3",
    "mime-types": "^3.0.2",
    "node-7z": "^3.0.0",
    "node-forge": "^1.4.3",
    "nodemailer": "^10.3.1",
    "pdfjs-dist": "^6.5.438",
    "pptx-preview": "^1.0.7",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.6",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "playwright-core": "^1.65.0",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
