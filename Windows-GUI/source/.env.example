# CloudBox 本地服务配置（复制为 .env 后按需修改）
# 监听端口：1024-65535，默认 8686
PORT=8686
# 监听地址：0.0.0.0 表示局域网可访问；127.0.0.1 表示仅本机
BIND=0.0.0.0
# 数据目录：SQLite、用户文件、日志都放在这里（默认 ./data）
# DATA_DIR=C:\CloudBoxData
# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 前端开发服务器（Vite）的 /api 代理目标，默认 http://127.0.0.1:8686
# API_TARGET=http://127.0.0.1:8686
