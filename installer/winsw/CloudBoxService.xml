<service>
  <id>CloudBox</id>
  <name>CloudBox</name>
  <description>CloudBox local cloud drive and Web admin</description>
  <executable>node.exe</executable>
  <arguments>dist\headless\index.mjs</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <env name="CLOUDBOX_DATA_DIR" value="%PROGRAMDATA%\CloudBox" />
  <logpath>%PROGRAMDATA%\CloudBox\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <onfailure action="restart" delay="10 sec" />
  <stoptimeout>15 sec</stoptimeout>
</service>
