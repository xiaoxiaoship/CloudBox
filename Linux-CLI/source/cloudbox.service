[Unit]
Description=CloudBox headless file server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloudbox
Group=cloudbox
WorkingDirectory=/opt/cloudbox
Environment=CLOUDBOX_DATA_DIR=/var/lib/cloudbox
ExecStart=/opt/cloudbox/bin/cloudbox start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
